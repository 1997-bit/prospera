<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvNombreEmpleado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/md_on_surface"
        android:textSize="15sp"
        tools:text="Juan Pérez" />

    <TextView
        android:id="@+id/tvCargoEmpleado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="6dp"
        tools:text="Cajero" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/tvBrutoFila"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/md_on_surface"
            android:textSize="13sp"
            tools:text="B/. 500.00" />

        <TextView
            android:id="@+id/tvDescuentosFila"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/error"
            android:textSize="13sp"
            tools:text="-B/. 50.00" />

        <TextView
            android:id="@+id/tvNetoFila"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/md_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="B/. 450.00" />
    </LinearLayout>
</LinearLayout>